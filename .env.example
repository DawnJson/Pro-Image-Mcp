PROIMAGE_API_KEY=sk-your-key-here
PROIMAGE_BASE_URL=https://newapi.prorisehub.com
PROIMAGE_SAVE_DIR=
# Output sandbox; defaults to PROIMAGE_SAVE_DIR. Every save_dir argument must resolve inside it.
PROIMAGE_SAVE_DIR_ROOT=
# Optional root for reference images; empty means any readable path is accepted.
PROIMAGE_INPUT_ROOT=
# Hosts allowed to serve generated images; defaults to the base URL host and its parent domain.
PROIMAGE_TRUSTED_DOWNLOAD_HOSTS=
PROIMAGE_DEFAULT_MODEL=gpt-image-2
PROIMAGE_TIMEOUT_MS=300000
PROIMAGE_CONCURRENCY=3
